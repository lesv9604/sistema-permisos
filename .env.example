# Backend (Render / local). Copia a .env y completa. Nunca subas .env al repo.
NODE_ENV=development
PORT=3000

# Supabase: usa la URL del Session pooler (IPv4), no la conexión directa.
DATABASE_URL=
DB_SSL=true

# Genera cada secreto con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d

# Orígenes permitidos (separados por coma). En producción: la URL de Vercel.
CORS_ORIGIN=http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:5173

# Correo (credenciales de usuarios nuevos y notificaciones). Sin API key los
# correos se SIMULAN y la contraseña temporal se muestra al ADMIN.
# SENDGRID_FROM debe ser un remitente verificado en el proveedor.
SENDGRID_API_KEY=
SENDGRID_FROM=

# URL pública del frontend (enlace en el correo de bienvenida).
FRONTEND_URL=http://localhost:5173

# Solo para el seed 02_usuario_admin (obligatorio si NODE_ENV=production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login con Google Workspace (opcional). Si alguno está vacío, el login con
# Google queda deshabilitado. El Client ID no es secreto.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=unipaz.edu.co
